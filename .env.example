# Copy this file to .env and fill in real values for local dev.
# In production (Render/Railway) set these as environment variables in the
# dashboard instead of committing a .env file.

SECRET_KEY=change-me-to-a-long-random-string

# Left unset -> SQLite file at ./dev.db (zero setup). Render/Railway inject a
# Postgres DATABASE_URL automatically when you attach their managed database.
DATABASE_URL=

# Estimates allowed per free-plan user per rolling 30 days.
FREE_TIER_MONTHLY_LIMIT=5

# --- Stripe -------------------------------------------------------------
# From the Stripe Dashboard (test mode keys while developing):
#   1. Create a "Pro" product with a recurring monthly price -> copy its price ID.
#   2. Developers > API keys -> secret + publishable key.
#   3. Developers > Webhooks -> add an endpoint at <your-domain>/billing/webhook,
#      select checkout.session.completed / customer.subscription.* -> signing secret.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

# --- Google sign-in -------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorized redirect URI: <your-domain>/auth/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Outgoing email (password reset) -------------------------------------
# Left blank -> reset links are printed to the server log instead of emailed,
# so local dev still works. A Gmail account with an "app password" works fine
# for low volume; swap in any SMTP provider for production.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
